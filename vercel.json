{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ai-services", "destination": "/ai-services.html" },
    { "source": "/AI%20Services.html", "destination": "/ai-services.html" },
    { "source": "/AI Services.html", "destination": "/ai-services.html" },
    { "source": "/project-management", "destination": "/project.html" },
    { "source": "/Project.html", "destination": "/project.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/Contact.html", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
